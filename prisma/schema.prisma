generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Department {
  Engineering
  HR
  Finance
  Sales
  Operations
  Marketing
}

model Employee {
  id        String   @id @default(cuid())
  fullName  String
  jobTitle  String
  country   String
  department Department @default(Engineering)
  salary    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([jobTitle])
  @@index([department])
}
