generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Department {
  Engineering
  HR
  Finance
  Sales
  Operations
  Marketing
}

model Employee {
  id        String   @id @default(cuid())
  fullName  String
  jobTitle  String
  country   String
  department Department @default(Engineering)
  salary    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([jobTitle])
  @@index([department])
}

model PayrollRun {
  id             String   @id @default(cuid())
  month          Int
  year           Int
  totalEmployees Int
  totalPayout    Decimal  @db.Decimal(14, 2)
  avgPayout      Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  @@index([year, month])
  @@unique([year, month])
}
