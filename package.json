{
  "name": "crafts-payroll",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "jest -c jest.config.cjs",
    "test:watch": "jest -c jest.config.cjs --watch",
    "test:ci": "jest -c jest.config.cjs --ci --runInBand --coverage",
    "test:unit": "jest -c jest.config.cjs --testPathPatterns=tests/unit",
    "test:unit:watch": "jest -c jest.config.cjs --testPathPatterns=tests/unit --watch",
    "test:unit:ci": "jest -c jest.config.cjs --testPathPatterns=tests/unit --ci --runInBand --coverage --coverageDirectory=coverage/unit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:clean": "tsx prisma/seed.ts --clean"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "@tailwindcss/postcss": "^4.2.4",
